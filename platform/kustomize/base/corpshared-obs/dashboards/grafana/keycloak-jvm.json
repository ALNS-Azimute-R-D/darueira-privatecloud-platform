{
  "uid": "keycloak-jvm",
  "title": "Keycloak - JVM, HTTP & Database Pool",
  "description": "The central identity provider (job keycloak): JVM memory, garbage collection, threads, the database connection pool (Agroal) and the HTTP server.",
  "tags": [
    "darueira",
    "keycloak",
    "iam",
    "jvm"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "DS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
