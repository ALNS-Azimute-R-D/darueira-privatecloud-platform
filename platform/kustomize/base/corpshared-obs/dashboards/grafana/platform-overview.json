          "range": true
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "CPU by namespace (top 8)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 18,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "topk(8, sum by (namespace) (rate(container_cpu_usage_seconds_total{container!=\"\",container!=\"POD\"}[5m])))",
          "legendFormat": "{{namespace}}",
          "instant": false,
          "range": true
        }
      ],
