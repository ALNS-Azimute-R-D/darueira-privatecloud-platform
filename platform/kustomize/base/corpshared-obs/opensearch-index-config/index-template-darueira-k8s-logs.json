{
  "index_patterns": [
    "darueira-k8s-logs-*"
  ],
  "priority": 100,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "30s",
      "translog.durability": "async",
      "translog.sync_interval": "30s"
    },
    "mappings": {
      "properties": {
        "log_processed": {
          "type": "flat_object"
        }
      }
    }
  }
}
